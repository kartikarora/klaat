{
  "$schema": "https://json.schemastore.org/design-tokens.json",
  "name": "@kartikarora Brand Design Tokens",
  "version": "2.0.0",
  "description": "Single Source of Truth (SSOT) for the @kartikarora design system across Web (SCSS) and Native (Jetpack Compose / Compose Multiplatform).",
  "color": {
    "light": {
      "paper":        { "value": "#ffffff", "hex": "#ffffff", "role": "background", "desc": "Base canvas background (Architectural Concrete/White)" },
      "paper-alt":    { "value": "#f4f6fa", "hex": "#f4f6fa", "role": "surfaceVariant", "desc": "Elevated cards, wells, panels" },
      "paper-sunken": { "value": "#e6ebf3", "hex": "#e6ebf3", "role": "surfaceContainerLowest", "desc": "Code blocks, inputs, sunken wells" },
      "card":         { "value": "#ffffff", "hex": "#ffffff", "role": "surface", "desc": "Card surface" },
      "ink":          { "value": "#0a111c", "hex": "#0a111c", "role": "onBackground", "desc": "Primary high-contrast text and headings" },
      "ink-muted":    { "value": "#49586e", "hex": "#49586e", "role": "onSurfaceVariant", "desc": "Secondary text, subtitles, metadata" },
      "ink-faint":    { "value": "#7f90a6", "hex": "#7f90a6", "role": "tertiary", "desc": "Disabled, borders, subtle text" },
      "rule":         { "value": "#cdd8e6", "hex": "#cdd8e6", "role": "outlineVariant", "desc": "Hairline borders and rules" },
      "rule-strong":  { "value": "#0a111c", "hex": "#0a111c", "role": "outline", "desc": "Active borders and dividers" },
      "signal":       { "value": "#0084c7", "hex": "#0084c7", "role": "primary", "desc": "Akihabara Cyan (High-contrast light)" },
      "signal-hover": { "value": "#009ceb", "hex": "#009ceb", "role": "primaryHover", "desc": "Hover state for signal" },
      "signal-wash":  { "value": "rgba(0, 132, 199, 0.12)", "hex": "0x1F0084C7", "role": "primaryContainer", "desc": "Translucent cyan wash" },
      "signal-ink":   { "value": "#ffffff", "hex": "#ffffff", "role": "onPrimary", "desc": "High-contrast text on signal fill" },
      "signal-secondary": { "value": "#e6b800", "hex": "#e6b800", "role": "secondary", "desc": "Caution Yellow secondary pop (Light)" },
      "signal-secondary-hover": { "value": "#ffcc00", "hex": "#ffcc00", "role": "secondaryHover", "desc": "Hover state for secondary pop" },
      "signal-secondary-ink": { "value": "#0a111c", "hex": "#0a111c", "role": "onSecondary", "desc": "High-contrast text on caution yellow" },
      "focus":        { "value": "#0084c7", "hex": "#0084c7", "role": "focus", "desc": "Instant accessibility focus ring" },
      "shadow":       { "value": "rgba(10, 17, 28, 0.08)", "hex": "#0a111c14", "role": "shadow", "desc": "Card elevation shadow" },
      "shadow-hover": { "value": "rgba(10, 17, 28, 0.14)", "hex": "#0a111c24", "role": "shadowHover", "desc": "Card hover elevation shadow" },
      "glow":         { "value": "rgba(0, 132, 199, 0.12)", "hex": "0x1F0084C7", "role": "glow", "desc": "Akihabara cyan glow" },
      "success":      { "value": "#2da44e", "hex": "#2da44e", "role": "success", "desc": "Success indicators and badges" },
      "danger":       { "value": "#cf222e", "hex": "#cf222e", "role": "error", "desc": "Danger/error alerts and badges" },
      "warning":      { "value": "#e6b800", "hex": "#e6b800", "role": "warning", "desc": "Caution yellow indicator" }
    },
    "dark": {
      "paper":        { "value": "#070a10", "hex": "#070a10", "role": "background", "desc": "Deep Space Obsidian canvas" },
      "paper-alt":    { "value": "#0d121c", "hex": "#0d121c", "role": "surfaceVariant", "desc": "Elevated panels in obsidian" },
      "paper-sunken": { "value": "#04060a", "hex": "#04060a", "role": "surfaceContainerLowest", "desc": "Sunken code blocks & terminals" },
      "card":         { "value": "#121824", "hex": "#121824", "role": "surface", "desc": "Card surface in obsidian" },
      "ink":          { "value": "#f0f6fc", "hex": "#f0f6fc", "role": "onBackground", "desc": "Pure crisp text" },
      "ink-muted":    { "value": "#8a9bb4", "hex": "#8a9bb4", "role": "onSurfaceVariant", "desc": "Muted slate secondary text" },
      "ink-faint":    { "value": "#4e5f7a", "hex": "#4e5f7a", "role": "tertiary", "desc": "Subtle / disabled in dark" },
      "rule":         { "value": "#1a2436", "hex": "#1a2436", "role": "outlineVariant", "desc": "Hairline borders in dark" },
      "rule-strong":  { "value": "#273752", "hex": "#273752", "role": "outline", "desc": "Active borders in dark" },
      "signal":       { "value": "#00f0ff", "hex": "#00f0ff", "role": "primary", "desc": "Akihabara Laser Cyan" },
      "signal-hover": { "value": "#33f3ff", "hex": "#33f3ff", "role": "primaryHover", "desc": "Hover state for signal" },
      "signal-wash":  { "value": "rgba(0, 240, 255, 0.14)", "hex": "0x2400F0FF", "role": "primaryContainer", "desc": "Translucent laser cyan wash" },
      "signal-ink":   { "value": "#000000", "hex": "#000000", "role": "onPrimary", "desc": "High-contrast text on laser cyan" },
      "signal-secondary": { "value": "#ffe600", "hex": "#ffe600", "role": "secondary", "desc": "Caution Yellow secondary pop (Dark)" },
      "signal-secondary-hover": { "value": "#fff34d", "hex": "#fff34d", "role": "secondaryHover", "desc": "Hover state for secondary pop" },
      "signal-secondary-ink": { "value": "#000000", "hex": "#000000", "role": "onSecondary", "desc": "High-contrast text on caution yellow" },
      "focus":        { "value": "#00f0ff", "hex": "#00f0ff", "role": "focus", "desc": "Instant focus ring in dark" },
      "shadow":       { "value": "rgba(0, 0, 0, 0.70)", "hex": "#000000b3", "role": "shadow", "desc": "Shadow in dark" },
      "shadow-hover": { "value": "rgba(0, 240, 255, 0.22)", "hex": "#00f0ff38", "role": "shadowHover", "desc": "Hover shadow in dark" },
      "glow":         { "value": "rgba(0, 240, 255, 0.16)", "hex": "0x2900F0FF", "role": "glow", "desc": "Laser cyan glow in dark" },
      "success":      { "value": "#3fb950", "hex": "#3fb950", "role": "success", "desc": "Success in dark" },
      "danger":       { "value": "#f85149", "hex": "#f85149", "role": "error", "desc": "Danger in dark" },
      "warning":      { "value": "#ffe600", "hex": "#ffe600", "role": "warning", "desc": "Caution yellow indicator" }
    }
  },
  "space": {
    "2xs": { "rem": "0.25rem", "px": 4,  "dp": 4 },
    "xs":  { "rem": "0.5rem",  "px": 8,  "dp": 8 },
    "sm":  { "rem": "1.0rem",  "px": 16, "dp": 16 },
    "md":  { "rem": "1.5rem",  "px": 24, "dp": 24 },
    "lg":  { "rem": "2.0rem",  "px": 32, "dp": 32 },
    "xl":  { "rem": "3.0rem",  "px": 48, "dp": 48 },
    "2xl": { "rem": "4.0rem",  "px": 64, "dp": 64 },
    "3xl": { "rem": "6.0rem",  "px": 96, "dp": 96 }
  },
  "radius": {
    "sm":   { "px": 6,   "dp": 6,   "desc": "Badges, tags, inputs" },
    "md":   { "px": 12,  "dp": 12,  "desc": "Standard cards, code blocks" },
    "lg":   { "px": 16,  "dp": 16,  "desc": "Modal sheets, large cards" },
    "pill": { "px": 100, "dp": 100, "desc": "Buttons, tabs, and pills" }
  },
  "typography": {
    "font-display": "\"Chivo\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif",
    "font-sans": "\"Chivo\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif",
    "font-mono": "\"JetBrains Mono\", \"SF Mono\", Monaco, \"Cascadia Code\", Consolas, monospace",
    "font-outlier": "\"JetBrains Mono\", \"SF Mono\", Monaco, \"Cascadia Code\", Consolas, monospace",
    "scale": {
      "display":   { "css": "clamp(2.5rem, 5.5vw, 4.25rem)", "sp": 48 },
      "display-s": { "css": "clamp(1.85rem, 4vw, 2.75rem)", "sp": 36 },
      "section":   { "css": "clamp(1.4rem, 2.75vw, 2.0rem)", "sp": 24 },
      "title":     { "css": "1.4rem", "sp": 20 },
      "lead":      { "css": "1.15rem", "sp": 18 },
      "body":      { "css": "1.0rem", "sp": 16 },
      "sm":        { "css": "0.875rem", "sp": 14 },
      "xs":        { "css": "0.75rem", "sp": 12 }
    }
  },
  "layout": {
    "max-width": "1200px",
    "max-width-narrow": "800px",
    "gutter": "var(--space-md)"
  },
  "motion": {
    "dur-micro": { "css": "120ms", "ms": 120 },
    "dur-short": { "css": "200ms", "ms": 200 },
    "dur-medium": { "css": "320ms", "ms": 320 },
    "ease-standard": { "css": "cubic-bezier(0.4, 0, 0.2, 1)", "compose": "FastOutSlowInEasing" },
    "ease-out": { "css": "cubic-bezier(0, 0, 0.2, 1)" },
    "ease-in": { "css": "cubic-bezier(0.4, 0, 1, 1)" }
  }
}
